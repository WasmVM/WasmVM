# `wasmvm --profile` through the real CLI (#61). Run as
#   cmake -DCASE=<case> -DAS=<wasmvm-as> -DWASMVM=<wasmvm>
#         -DSRC=<this directory> -DBIN=<scratch directory> -P run_profile.cmake
#
# normal     main.wasm (importing lib.wasm and sys_proc) returns: exit 0, one
#            section per start function, exact counts, folded call paths
# trap       trap.wasm traps: exit -1, the report is written, frames closed
# exit       exit.wasm calls sys_proc.exit(3): exit 3, the report is written
# unwritable the prefix is in a missing directory: error, exit -1

file(REMOVE_RECURSE ${BIN})
file(MAKE_DIRECTORY ${BIN})

function(assemble name)
  execute_process(COMMAND ${AS} ${SRC}/${name}.wat -o ${BIN}/${name}.wasm
    RESULT_VARIABLE result ERROR_VARIABLE err)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "wasmvm-as ${name}.wat failed (${result}): ${err}")
  endif()
endfunction()

# Runs wasmvm --profile ${BIN}/out on `module`; sets exit_code and stderr.
function(profile module)
  execute_process(COMMAND ${WASMVM} --no-system --profile ${ARGN} ${BIN}/${module}.wasm
    WORKING_DIRECTORY ${BIN}
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(exit_code "${result}" PARENT_SCOPE)
  set(stderr "${err}" PARENT_SCOPE)
endfunction()

function(expect_eq what actual expected)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "${what}: expected '${expected}', got '${actual}'")
  endif()
endfunction()

# Sets `json` to the report and `folded` to the folded file.
function(read_report)
  foreach(ext json folded)
    if(NOT EXISTS ${BIN}/out.${ext})
      message(FATAL_ERROR "out.${ext} was not written")
    endif()
  endforeach()
  file(READ ${BIN}/out.json text)
  string(JSON version ERROR_VARIABLE error GET "${text}" version)
  if(error)
    message(FATAL_ERROR "out.json does not parse: ${error}\n${text}")
  endif()
  expect_eq("version" "${version}" "1")
  string(JSON unit GET "${text}" time_unit)
  expect_eq("time_unit" "${unit}" "ns")
  file(READ ${BIN}/out.folded folded_text)
  set(json "${text}" PARENT_SCOPE)
  set(folded "${folded_text}" PARENT_SCOPE)
endfunction()

# Sets `found` to the index of function `name` in section `section`, or -1.
function(find_function section name)
  set(found -1)
  string(JSON count LENGTH "${json}" stacks ${section} functions)
  math(EXPR last "${count} - 1")
  foreach(i RANGE ${last})
    string(JSON n GET "${json}" stacks ${section} functions ${i} name)
    if(n STREQUAL name)
      set(found ${i})
    endif()
  endforeach()
  set(found ${found} PARENT_SCOPE)
endfunction()

# Expects `key` of function `name` in `section` to be `expected`.
function(expect_function section name key expected)
  find_function(${section} ${name})
  if(found EQUAL -1)
    message(FATAL_ERROR "section ${section} lists no ${name}:\n${json}")
  endif()
  # `key` may be a path, e.g. "instructions;call".
  string(JSON value GET "${json}" stacks ${section} functions ${found} ${key})
  expect_eq("section ${section} ${name} ${key}" "${value}" "${expected}")
endfunction()

# Every function of every section: times are not negative, exclusive is not
# above inclusive.
function(expect_times_sane)
  string(JSON sections LENGTH "${json}" stacks)
  math(EXPR last_section "${sections} - 1")
  foreach(s RANGE ${last_section})
    string(JSON count LENGTH "${json}" stacks ${s} functions)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON incl GET "${json}" stacks ${s} functions ${i} inclusive_ns)
      string(JSON excl GET "${json}" stacks ${s} functions ${i} exclusive_ns)
      if(incl LESS 0 OR excl LESS 0 OR excl GREATER incl)
        message(FATAL_ERROR "section ${s} function ${i}: inclusive ${incl}, exclusive ${excl}")
      endif()
    endforeach()
  endforeach()
endfunction()

function(expect_folded_line path)
  string(REGEX MATCH "(^|\n)${path} [0-9]+\n" line "${folded}")
  if(NOT line)
    message(FATAL_ERROR "out.folded has no line for ${path}:\n${folded}")
  endif()
endfunction()

if(CASE STREQUAL "normal")
  assemble(lib)
  assemble(main)
  profile(main ${BIN}/out)
  expect_eq("exit code" "${exit_code}" "0")
  read_report()
  string(JSON sections LENGTH "${json}" stacks)
  expect_eq("sections" "${sections}" "2")
  string(JSON entry GET "${json}" stacks 0 entry)
  expect_eq("section 0 entry" "${entry}" "lib.wasm:$init")
  string(JSON entry GET "${json}" stacks 1 entry)
  expect_eq("section 1 entry" "${entry}" "main.wasm:$main")
  # fib(5): 15 calls; 7 of them recurse (n >= 2), 8 return n.
  expect_function(1 "$fib" calls 15)
  expect_function(1 "$fib" host OFF)  # string(JSON) reads false as OFF
  expect_function(1 "$fib" "instructions;call" 14)
  expect_function(1 "$fib" "instructions;if" 15)
  expect_function(1 "$fib" "instructions;i32.add" 7)
  expect_function(1 "$main" calls 1)
  expect_function(1 "$g" calls 1)
  expect_function(1 "$g" module "lib.wasm")
  expect_function(1 "argc" calls 1)
  expect_function(1 "argc" host ON)
  expect_function(1 "argc" module "sys_proc")
  expect_function(0 "$init" calls 1)
  find_function(0 "$main")
  expect_eq("section 0 lists $main" "${found}" "-1")
  expect_times_sane()
  expect_folded_line("lib\\.wasm:\\$init")
  expect_folded_line("main\\.wasm:\\$main;main\\.wasm:\\$fib;main\\.wasm:\\$fib")
  expect_folded_line("main\\.wasm:\\$main;lib\\.wasm:\\$g")
  expect_folded_line("main\\.wasm:\\$main;sys_proc:argc")
elseif(CASE STREQUAL "trap")
  assemble(trap)
  profile(trap ${BIN}/out)
  if(exit_code EQUAL 0)
    message(FATAL_ERROR "a trap exited 0")
  endif()
  if(NOT stderr MATCHES "unreachable")
    message(FATAL_ERROR "no trap message: ${stderr}")
  endif()
  read_report()
  expect_function(0 "$a" calls 1)
  expect_function(0 "$a" "instructions;unreachable" 1)
  expect_function(0 "$main" calls 1)
  expect_times_sane()
  expect_folded_line("trap\\.wasm:\\$main;trap\\.wasm:\\$a")
elseif(CASE STREQUAL "exit")
  assemble(exit)
  profile(exit ${BIN}/out)
  expect_eq("exit code" "${exit_code}" "3")
  read_report()
  expect_function(0 "$a" calls 1)
  expect_function(0 "exit" calls 1)
  expect_function(0 "exit" module "sys_proc")
  expect_times_sane()
  expect_folded_line("exit\\.wasm:\\$main;exit\\.wasm:\\$a;sys_proc:exit")
elseif(CASE STREQUAL "unwritable")
  assemble(lib)
  profile(lib ${BIN}/missing/out)
  expect_eq("exit code" "${exit_code}" "255")
  if(NOT stderr MATCHES "cannot write ${BIN}/missing/out\\.json")
    message(FATAL_ERROR "no write error: ${stderr}")
  endif()
else()
  message(FATAL_ERROR "unknown CASE ${CASE}")
endif()
